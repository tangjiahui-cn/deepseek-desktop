{
  "name": "chat-demo",
  "version": "0.1.7",
  "description": "基于 DeepSeek API 的聊天应用，支持 Web 与 Electron 桌面端。",
  "license": "MIT",
  "private": true,
  "type": "module",
  "productName": "DeepSeek Desktop",
  "main": "electron/dist/main.cjs",
  "appId": "com.tangjiahui.deepseekdesktop",
  "packageManager": "pnpm@11.26.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tangjiahui-cn/deepseek-desktop.git"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "rspack serve -c rspack.config.ts",
    "build": "node scripts/build-renderer.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "build:desktop": "pnpm build && pnpm build:electron",
    "type": "tsc -p tsconfig.json && tsc -p tsconfig.electron.json",
    "lint": "oxlint src electron scripts rspack.config.ts electron-builder.config.cjs",
    "format": "oxfmt --write .",
    "dist:dir": "pnpm build:desktop && electron-builder --config electron-builder.config.cjs --dir --publish never",
    "dist:mac": "pnpm build:desktop && electron-builder --config electron-builder.config.cjs --mac --x64 --arm64 --publish never",
    "dist:win": "pnpm build:desktop && electron-builder --config electron-builder.config.cjs --win --x64 --publish never",
    "dist:linux": "pnpm build:desktop && electron-builder --config electron-builder.config.cjs --linux --x64 --publish never"
  },
  "dependencies": {
    "@types/katex": "^0.16.5",
    "@types/mdast": "~4.0.3",
    "@types/prismjs": "^1.26.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "clsx": "2.1.1",
    "electron-updater": "6.8.12",
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "katex": "0.16.22",
    "mdast-util-find-and-replace": "3.0.2",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mermaid": "11.10.1",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-llm-math": "3.1.0",
    "prismjs": "1.30.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.4.7"
  },
  "devDependencies": {
    "@rspack/cli": "2.0.2",
    "@rspack/core": "2.0.2",
    "@rspack/dev-server": "2.0.1",
    "@swc/helpers": "0.5.23",
    "@types/node": "~20.9.2",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "typescript": "7.0.2"
  },
  "volta": {
    "node": "24.21.0",
    "pnpm": "11.26.0"
  },
  "author": "tangjiahui-cn"
}
